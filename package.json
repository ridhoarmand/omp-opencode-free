{
  "name": "omp-opencode-free",
  "version": "1.0.2",
  "description": "Zero-config free OpenCode models provider for OMP and Pi",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "ridhoarmand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridhoarmand/omp-opencode-free.git"
  },
  "bugs": "https://github.com/ridhoarmand/omp-opencode-free/issues",
  "homepage": "https://github.com/ridhoarmand/omp-opencode-free#readme",
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/**/*.map",
    "index.ts",
    "omp-entry.ts",
    "src",
    "!src/*.test.*",
    "README.md",
    "MAINTENANCE.md",
    "LICENSE"
  ],
  "keywords": [
    "omp-plugin",
    "omp-package",
    "omp-extension",
    "pi-package",
    "opencode",
    "free-models"
  ],
  "omp": {
    "extensions": [
      "./omp-entry.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "bun test src/",
    "smoke": "bun scripts/smoke-real.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
